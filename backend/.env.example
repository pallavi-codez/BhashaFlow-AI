# BhashaFlow AI — Backend Environment Variables
# Copy this to .env and fill in your real values.
# NEVER commit .env to version control.

# ─── Gnani AI ─────────────────────────────────────────────────────────────────
# Get your key from https://app.gnani.ai/voice
GNANI_API_KEY=your_gnani_api_key_here

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, local dev):
DATABASE_URL=sqlite:///./bhashaflow.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/bhashaflow

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-32-char-hex-string

# ─── Limits ───────────────────────────────────────────────────────────────────
MAX_AUDIO_SIZE_MB=10
GNANI_TIMEOUT_SECONDS=30

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
